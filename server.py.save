# HTML رابط چت
# ============================================================

HTML = """<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DevStudio Bot</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:system-ui,-apple-system,sans-serif;background:linear-gradient(135deg,#0A0E27,#1a1f3a);height:100vh;display:flex;flex-direction:column;color:#fff;overflow:hidden}
header{padding:16px 20px;background:rgba(0,0,0,.3);border-bottom:1px solid rgba(255,255,255,.1);display:flex;align-items:center;gap:12px}
.logo{font-size:1.2rem;font-weight:800;background:linear-gradient(135deg,#6C63FF,#00D9A3);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.status{font-size:.75rem;color:#00D9A3;margin-left:auto}
#chat{flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:10px}
.msg{max-width:85%;padding:12px 16px;border-radius:16px;line-height:1.6;font-size:.95rem;white-space:pre-wrap;word-wrap:break-word}
.user{align-self:flex-end;background:linear-gradient(135deg,#6C63FF,#00D9A3);border-bottom-right-radius:4px}
.bot{align-self:flex-start;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.15);border-bottom-left-radius:4px}
.hint{color:rgba(255,255,255,.4);font-size:.85rem;text-align:center;padding:20px}
#input-area{padding:14px;background:rgba(0,0,0,.3);border-top:1px solid rgba(255,255,255,.1);display:flex;gap:10px}
#input{flex:1;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);color:#fff;padding:14px 18px;border-radius:12px;font-size:1rem;outline:none;font-family:inherit}
#input::placeholder{color:rgba(255,255,255,.4)}
#send{background:linear-gradient(135deg,#6C63FF,#00D9A3);color:#fff;border:none;padding:0 24px;border-radius:12px;font-weight:700;cursor:pointer;font-family:inherit;font-size:1rem}
#send:active{transform:scale(.95)}
</style>
</head>
<body>
<header>
  <div class="logo">DevStudio Bot</div>
  <div class="status">Online / آنلاین</div>
</header>
<div id="chat">
  <div class="hint">برای شروع پیام بنویسید. Try: hello / سلام</div>
</div>
<div id="input-area">
  <input id="input" type="text" placeholder="پیام خود را بنویسید..." autocomplete="off">
  <button id="send">Send / ارسال</button>
</div>
<script>
var chat = document.getElementById('chat');
var input = document.getElementById('input');
var send = document.getElementById('send');
var hint = document.querySelector('.hint');

function addMsg(text, sender) {
  if (hint) { hint.remove(); hint = null; }
  var d = document.createElement('div');
  d.className = 'msg ' + sender;
  d.textContent = text;
  chat.appendChild(d);
  chat.scrollTop = chat.scrollHeight;
}

async function sendMsg() {
  var t = input.value.trim();
  if (!t) return;
  addMsg(t, 'user');
  input.value = '';
  input.disabled = true;
  send.disabled = true;
  try {
    var r = await fetch('/chat', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({message: t, user_id: 'web'})
    });
    var data = await r.json();
    addMsg(data.reply, 'bot');
  } catch(e) {
    addMsg('Error: ' + e.message, 'bot');
  }
  input.disabled = false;
  send.disabled = false;
  input.focus();
}

send.addEventListener('click', sendMsg);
input.addEventListener('keypress', function(e) {
  if (e.key === 'Enter') sendMsg();
});
input.focus();
</script>
</body>
</html>"""


# ============================================================
# HTTP Server
# ============================================================

class H(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def do_GET(self):
        p = urlparse(self.path).path
        if p in ["/", "/index.html"]:
            self._s(200, "text/html; charset=utf-8", HTML)
        elif p == "/health":
            self._s(200, "application/json", json.dumps({"status": "healthy"}))
        else:
            self._s(404, "text/plain", "Not Found")

    def do_POST(self):
        p = urlparse(self.path).path
        if p == "/chat":
            try:
                n = int(self.headers.get("Content-Length", 0))
                b = self.rfile.read(n).decode("utf-8")
                d = json.loads(b)
                m = d.get("message", "")
                r = process(m)
                intent, _, lang = route_intent(m)
                resp = {
                    "reply": r,
                    "intent": intent,
                    "lang": lang,
                    "time": datetime.now().isoformat(),
                    "user_id": "web"
                }
                self._s(200, "application/json", json.dumps(resp, ensure_ascii=False))
            except Exception as e:
                self._s(500, "application/json", json.dumps({"error": str(e)}, ensure_ascii=False))
        else:
            self._s(404, "text/plain", "Not Found")

    def _s(self, code, ct, body):
        self.send_response(code)
        self.send_header("Content-Type", ct)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Content-Length", str(len(body.encode("utf-8"))))
        self.end_headers()
        self.wfile.write(body.encode("utf-8"))


if __name__ == "__main__":
    print("=" * 50)
    print("DevStudio Bot Server (Bilingual)")
    print("Open: http://localhost:8000")
    print("Stop: Ctrl+C")
    print("=" * 50)
    try:
        import os
if __name__ == "__main__":
    port = int(os.environ.get("PORT", 8000))
    print("=" * 50)
    print("DevStudio Bot Server (Bilingual)")
    print("Port: " + str(port))
    print("=" * 50)
    try:
        HTTPServer(("0.0.0.0", port), H).serve_forever()
    except KeyboardInterrupt:
        print("\nStopped.")
